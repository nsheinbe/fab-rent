# ---- Database (required) -------------------------------------------------
# Plain Postgres (local dev without Docker) or the Supabase Postgres connection string.
#   supabase start  ->  postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fabrent

# ---- Supabase (optional; enables Google/Apple/OTP auth, Storage, Realtime) ----
# Leave unset to run in demo mode: cookie sessions with seeded demo accounts,
# photos stored on local disk under .data/storage, OTP codes logged to console.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App --------------------------------------------------------------------
# Secret used to sign demo sessions and local "signed URLs".
APP_SECRET=change-me-in-production
# Freeze the clock for the demo (market time, ISO without offset). Unset for real time.
DEMO_NOW=2026-09-05T10:00:00
# Protects /api/cron/* routes.
CRON_SECRET=change-me

# ---- Payments ---------------------------------------------------------------
# mock (default) | stripe. Stripe is fail-closed: all three secrets below are required.
# CI and Playwright always force mock (hermetic). Set HERMETIC=0 only for an explicit live-secret job.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Enables /api/e2e/inspect for money-path Playwright specs. Never set beside Stripe.
E2E_INSPECT=
# MRD is fictional; Stripe test mode runs in this real currency.
STRIPE_CURRENCY=usd
# Stripe mode also needs the webhook (payment_intent.canceled, payment_intent.payment_failed,
# charge.dispute.created) pointed at /api/webhooks/stripe.

# ---- Payouts (Stripe Connect · Phase 7) ----------------------------------------
# mock (default) | stripe. The mock never touches the network: hosted onboarding is simulated at
# /provider/earnings/onboarding and transfers are recorded. Stripe is fail-closed: it needs the two
# secrets below AND PAYMENTS_PROVIDER=stripe (transfers draw on the same Stripe balance as the
# charges), and CI refuses it unless HERMETIC=0. Test and live mode are separated by configuration:
# an sk_live_ key is refused unless PAYOUTS_LIVE_MODE=1, a test key is refused with it, and CI
# never accepts the flag — no test-mode run can move live money.
PAYOUTS_PROVIDER=mock
# Signing secret of the Stripe webhook endpoint that listens to *connected account* events
# (account.updated, account.external_account.*, payout.failed) — same URL, /api/webhooks/stripe.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Country of new Express accounts (Stripe two-letter code). Port Maren is fictional; test mode uses US.
STRIPE_CONNECT_COUNTRY=US
# Set to 1 only for a deliberate live deployment with an sk_live_ key. Never in CI.
PAYOUTS_LIVE_MODE=

# ---- Notifications ------------------------------------------------------------
# console (default) | resend. The console adapter never touches the network: it logs each message
# (including sign-in codes) to the server console and records it. Resend is fail-closed: both
# secrets below are required, and CI refuses it unless HERMETIC=0.
NOTIFICATIONS_PROVIDER=console
RESEND_API_KEY=
# Sender on an authenticated domain, e.g. "fab.rent <bookings@mail.fab.rent>"
NOTIFICATIONS_FROM=
NOTIFICATIONS_REPLY_TO=
# Absolute origin used for links inside emails.
APP_URL=http://localhost:3000

# ---- Maps ---------------------------------------------------------------------
# Set to 1 to keep the design's placeholder tiles instead of loading MapLibre demo tiles.
NEXT_PUBLIC_DISABLE_MAPLIBRE=
