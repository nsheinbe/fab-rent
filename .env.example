# ---- Database (required) -------------------------------------------------
# Plain Postgres (local dev without Docker) or the Supabase Postgres connection string.
#   supabase start  ->  postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fabrent

# ---- Supabase (optional; enables Google/Apple/OTP auth, Storage, Realtime) ----
# Leave unset to run in demo mode: cookie sessions with seeded demo accounts,
# photos stored on local disk under .data/storage, OTP codes logged to console.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App --------------------------------------------------------------------
# Secret used to sign demo sessions and local "signed URLs".
APP_SECRET=change-me-in-production
# Freeze the clock for the demo (market time, ISO without offset). Unset for real time.
DEMO_NOW=2026-09-05T10:00:00
# Protects /api/cron/* routes.
CRON_SECRET=change-me

# ---- Payments ---------------------------------------------------------------
# mock (default) | stripe
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
